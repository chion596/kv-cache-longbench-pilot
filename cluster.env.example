# Настройки для кластера ВШЭ.
# Используем ранее загруженные веса в старом scratch в режиме только чтения.
# Этот файл не содержит секретов. Не коммитьте личный cluster.env.
export MODEL_PATH="$(ws_find kv-cache)/models/Qwen3-1.7B"
export HF_HOME="$(ws_find kv-cache)/hf-cache"
export HF_HUB_DISABLE_TELEMETRY=1
